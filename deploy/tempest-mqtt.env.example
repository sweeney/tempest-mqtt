# tempest-mqtt config for a manual install (make install puts it at
# /etc/tempest-mqtt/tempest-mqtt.env if there is none). Every key must be
# present: the unit passes each one as a flag. Leave a value empty for none.
MQTT_BROKER_URL=tcp://localhost:1883
MQTT_CLIENT_ID=tempest-mqtt
MQTT_USERNAME=
MQTT_PASSWORD=
# topics: climate/<TOPIC_PREFIX>/...
TOPIC_PREFIX=tempest
TEMPEST_UDP_PORT=50222
LOG_LEVEL=info
