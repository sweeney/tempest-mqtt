# tempest-mqtt: pi3b-schoolhouse. deploy/deploy.sh --site schoolhouse installs it
# as /etc/tempest-mqtt/tempest-mqtt.env if the host has none; edits there are kept.
#
# The Pi's local broker, bridged to garibaldi (pi-setup/mqtt-bridge). The bridge
# forwards only the namespaces it lists, so climate/schoolhouse/# needs a line
# there before these topics reach garibaldi.
MQTT_BROKER_URL=tcp://127.0.0.1:1883
MQTT_CLIENT_ID=tempest-mqtt-schoolhouse
MQTT_USERNAME=
MQTT_PASSWORD=
# topics: climate/schoolhouse/...
TOPIC_PREFIX=schoolhouse
TEMPEST_UDP_PORT=50222
LOG_LEVEL=info
